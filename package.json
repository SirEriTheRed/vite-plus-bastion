{
  "name": "@erithered/vite-plus-bastion",
  "version": "0.0.2",
  "private": true,
  "description": "A typescript fullstack project template centered around code quality and CI/CD",
  "keywords": [
    "typescript",
    "template",
    "quality",
    "ci-cd"
  ],
  "homepage": "https://github.com/SirEriTheRed/vite-plus-bastion#readme",
  "bugs": {
    "url": "https://github.com/SirEriTheRed/vite-plus-bastion/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SirEriTheRed/vite-plus-bastion.git"
  },
  "license": "MIT",
  "author": "erithered",
  "type": "module",
  "scripts": {
    "actionlint": "actionlint -color",
    "actionlint:docker": "docker run --rm -v $(pwd):/repo --workdir /repo rhysd/actionlint:1.7.12 -color",
    "analyze": "knip",
    "audit:signatures": "pnpm audit signatures",
    "audit:signatures:warn": "pnpm audit signatures || true",
    "build": "pnpm -r build",
    "check": "pnpm run lint && pnpm run lint:package && pnpm run type-check && pnpm run type-check:tests && pnpm run format:check && pnpm run editorconfig && pnpm run ls-lint && pnpm run knip && pnpm run depcruise",
    "clean": "pnpm -r clean",
    "cleanup": "rm -rf dist reports .nyc_output tmp temp .cache *.tsbuildinfo && pnpm -r cleanup",
    "codeql": "bash scripts/codeql-scan.sh",
    "commit": "cz",
    "depcruise": "depcruise apps packages --output-type err-long",
    "depcruise:graph": "depcruise apps packages --include-only '^(apps|packages)/' --output-type dot | dot -T svg > dependency-graph.svg",
    "depcruise:html": "mkdir -p reports/depcruiser && depcruise apps packages --output-type err-html --output-to reports/depcruiser/index.html",
    "dev": "pnpm -r --parallel dev",
    "docs": "rm -rf docs/api && typedoc",
    "docs:html": "typedoc --options typedoc.html.json",
    "docs:watch": "typedoc --watch",
    "editorconfig": "editorconfig-checker",
    "editorconfig:docker": "docker run --rm --volume=$PWD:/check mstruebing/editorconfig-checker",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "knip": "knip",
    "licenses": "license-checker",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:package": "npmPkgJsonLint .",
    "lint:spell": "cspell lint \"**/*.{ts,md,json}\" --no-progress",
    "ls-lint": "ls-lint",
    "osv": "osv-scanner scan source -r .",
    "osv:html": "mkdir -p reports && osv-scanner scan source -r . --format html --output-file reports/osv-report.html",
    "osv:html:force": "mkdir -p reports && osv-scanner scan source -r . --format html --output-file reports/osv-report.html || true",
    "package:sort": "sort-package-json",
    "prepare": "husky",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "reuse": "reuse lint",
    "reuse:annotate": "bash scripts/reuse-annotate.sh",
    "sbom": "mkdir -p reports/sbom && pnpm sbom --sbom-format spdx --lockfile-only > reports/sbom/sbom.spdx.json",
    "sbom:all": "pnpm run sbom && pnpm run sbom:cyclonedx",
    "sbom:cyclonedx": "mkdir -p reports/sbom && pnpm sbom --sbom-format cyclonedx --lockfile-only > reports/sbom/sbom.cyclonedx.json",
    "secretlint": "secretlint \"**/*\"",
    "secretlint:mask": "secretlint --maskSecrets \"**/*\"",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:coverage:watch": "pnpm -r test:coverage:watch",
    "test:ui": "pnpm -r test:ui",
    "test:watch": "pnpm -r test:watch",
    "type-check": "pnpm -r type-check",
    "type-check:tests": "pnpm -r type-check:tests",
    "zizmor": "zizmor .",
    "zizmor:sarif": "mkdir -p reports && zizmor --format sarif . > reports/zizmor.sarif"
  },
  "allowScripts": {
    "editorconfig-checker@7.0.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/cz-commitlint": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^9.0.0",
    "@ls-lint/ls-lint": "2.3.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@types/node": "^26.6.6",
    "@vitest/eslint-plugin": "^1.6.28",
    "commitizen": "^4.3.2",
    "commitlint": "^21.2.4",
    "cspell": "^10.5.2",
    "dependency-cruiser": "^18.9.0",
    "editorconfig-checker": "7.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "eslint-plugin-unicorn": "80.0.0",
    "husky": "^9.1.7",
    "inquirer": "^9.3.8",
    "knip": "^6.48.0",
    "license-checker": "^25.0.1",
    "lint-staged": "^17.6.2",
    "npm-package-json-lint": "11.0.1",
    "secretlint": "^14.1.0",
    "semantic-release": "^26.0.1",
    "sort-package-json": "^4.1.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite-plus": "^1.8.0"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
